<!DOCTYPE html>
<html lang="en" data-theme="<%= theme %>">
<%- include('./partials/head') %>

  <body>
    <%- include('./partials/header') %>
      <main>
        <% if (user) { %>
          You are logged in as <%= locals.user.email %>
            <% } else { %>
              <div class="center-menu">
                <div class="subtitle">Welcome to the clubhouse!</div>
                <div class="auth-buttons">
                  <a href="/login" class="button primary login">Login</a>
                  <div>Don't have an account? <a href="/register" class="link">Register</a></div>
                </div>
              </div>
              <% } %>
      </main>
      <%- include('./partials/footer') %>

  </body>

</html>